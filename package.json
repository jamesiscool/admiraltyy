{
	"name": "admiraltyy",
	"version": "0.0.1",
	"description": "A modern, unified Usenet media automation platform",
	"license": "MIT",
	"author": "Admiraltyy",
	"type": "module",
	"scripts": {
		"apigen": "openapi-ts -f src/server/api/openapi-ts.config.ts",
		"build": "vite build",
		"db:generate": "drizzle-kit generate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"dev": "concurrently --kill-others -n client,server,design -c cyan,magenta,yellow \"bun run dev:client\" \"bun run dev:server\" \"bun run dev:design\"",
		"dev:client": "vite",
		"dev:design": "cd design && bun run dev",
		"dev:server": "bun --hot src/server/index.ts",
		"fix": "biome check . --write",
		"preview": "vite preview",
		"tsc": "tsc --noEmit"
	},
	"dependencies": {
		"@base-ui/react": "^1.0.0",
		"@fontsource-variable/inter": "^5.2.8",
		"@fontsource-variable/jetbrains-mono": "^5.2.8",
		"@t3-oss/env-core": "^0.13.10",
		"@tanstack/react-devtools": "^0.7.11",
		"@tanstack/react-query": "^5.90.15",
		"@tanstack/react-router": "^1.144.0",
		"@tanstack/react-router-devtools": "^1.144.0",
		"@tanstack/react-table": "^8.21.3",
		"@tanstack/router-plugin": "^1.145.1",
		"better-sqlite3": "^12.5.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.1",
		"drizzle-zod": "^0.8.3",
		"hono": "^4.11.3",
		"lucide-react": "^0.544.0",
		"ofetch": "^1.5.1",
		"react": "^19.2.3",
		"react-dom": "^19.2.3",
		"shadcn": "^3.6.2",
		"tailwind-merge": "^3.4.0",
		"tailwindcss": "^4.1.18",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.2.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.10",
		"@hey-api/openapi-ts": "^0.89.2",
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/devtools-vite": "^0.4.0",
		"@tanstack/react-query-devtools": "^5.91.2",
		"@types/better-sqlite3": "^7.6.13",
		"@types/bun": "latest",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.1.2",
		"concurrently": "^9.1.2",
		"drizzle-kit": "^0.31.8",
		"vite": "^7.3.0"
	}
}
