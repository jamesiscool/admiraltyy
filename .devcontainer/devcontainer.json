{
	"name": "base-setup",
	"image": "mcr.microsoft.com/devcontainers/javascript-node:24",
	"features": {
		"ghcr.io/devcontainers/features/common-utils:2": {
			"installOhMyZsh": true,
			"configureZshAsDefaultShell": true
		},
		"ghcr.io/devcontainers/features/docker-in-docker:2": {
			"moby": false
		},
		"ghcr.io/devcontainers/features/sshd:1": {},
		"ghcr.io/shyim/devcontainers-features/bun:0": {},
		"ghcr.io/stu-bell/devcontainer-features/claude-code:0": {}
	},
	"workspaceMount": "source=/Users/jlles/Projects/admiraltyy,target=/workspace,type=bind",
	"workspaceFolder": "/workspace",
	"mounts": [
		"source=${localEnv:HOME}/.config/zsh/aliases.zsh,target=/home/node/.config/zsh/aliases.zsh,type=bind,readonly"
	],
	"postCreateCommand": "bun add -g @antfu/ni && echo 'source ~/.config/zsh/aliases.zsh' >> ~/.zshrc",
	"customizations": {
		"vscode": {
			"settings": {},
			"extensions": []
		}
	}
}
